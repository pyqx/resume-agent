# Resume Agent 环境配置模板 — 复制为 .env 后填写
# cp .env.example .env

# ── LLM 供应商(必填)─────────────────────────────
# anthropic 或 openai_compatible(DeepSeek 等 OpenAI 兼容接口)
LLM_PROVIDER=openai_compatible
LLM_API_KEY=你的API密钥
LLM_MODEL=deepseek-chat
# OpenAI 兼容模式必填;anthropic 模式留空
LLM_BASE_URL=https://api.deepseek.com

# ── LLM 行为(可选)──────────────────────────────
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096
# LLM_TIMEOUT=120
# LLM_RETRY_MAX=2

# ── 隐私(可选)──────────────────────────────────
# 发送给 LLM 前对手机号/邮箱/身份证/薪资/微信做可逆掩码(默认开启)
# SANITIZE_PII=true

# ── GitHub 分析(可选,强烈建议)───────────────────
# 不设置时受未认证限额约束(60 次/小时)
# GITHUB_TOKEN=ghp_xxx

# ── 服务(可选)──────────────────────────────────
# HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO
# 调试端点(/resume/debug-parse),默认关闭
# DEBUG_ENDPOINTS=false

# ── 限额(可选)──────────────────────────────────
# MAX_UPLOAD_SIZE_MB=10
# EXPORT_TEXT_MAX_CHARS=200000
